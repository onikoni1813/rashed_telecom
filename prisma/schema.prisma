// Prisma Schema for Rashed Telecom Shop Management PWA
// Architecture defined in Master_plan.md (Sections 3, 6, 11, 12)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// 6.1 SHOP, IDENTITY, ROLES AND SETTINGS
// ==============================================================================

model Shop {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("BDT")
  timezone  String   @default("Asia/Dhaka")
  settings  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members         ShopMember[]
  staffProfiles   StaffProfile[]
  roles           Role[]
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]

  @@map("shops")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid // Matches Supabase Auth uid
  email     String?  @unique
  phone     String?  @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   ShopMember[]
  staffProfiles StaffProfile[]
  auditActions  AuditLog[]     @relation("ActorAuditLogs")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String?  @map("shop_id") @db.Uuid // Nullable for global system roles
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop            Shop?            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  members         ShopMember[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. 'products.view', 'sales.create'
  description String
  module      String   // e.g. 'products', 'sales', 'service', 'accounting'
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model ShopMember {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@index([roleId])
  @@map("shop_members")
}

model StaffProfile {
  id               String    @id @default(uuid()) @db.Uuid
  shopId           String    @map("shop_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  employeeCode     String    @map("employee_code")
  joiningDate      DateTime  @map("joining_date")
  compensationType String    @default("SALARY") @map("compensation_type") // SALARY, COMMISSION, HOURLY
  baseSalary       Decimal   @default(0) @map("base_salary") @db.Decimal(12, 2)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([shopId, employeeCode])
  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("staff_profiles")
}

// ==============================================================================
// 6.7 AUDIT LOGS AND IDEMPOTENCY
// ==============================================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  action      String   // e.g. 'member.create', 'role.assign', 'settings.update'
  entityType  String   @map("entity_type") // e.g. 'ShopMember', 'StaffProfile'
  entityId    String   @map("entity_id")
  reason      String?
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  actor User @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@index([shopId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  key          String
  requestHash  String    @map("request_hash")
  status       String    @default("PENDING") // PENDING, COMPLETED, FAILED
  statusCode   Int?      @map("status_code")
  responseBody Json?     @map("response_body")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, key])
  @@index([shopId, createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
