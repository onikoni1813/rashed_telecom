# ==============================================================================
# Rashed Telecom — Environment Configuration
# ==============================================================================
# All sensitive secrets must be kept out of version control and browser bundles.
# Copy this file to .env.local for local development.

# Application Configuration
NEXT_PUBLIC_APP_NAME="Rashed Telecom"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="bn"
NEXT_PUBLIC_DEFAULT_CURRENCY="BDT"
NEXT_PUBLIC_TIMEZONE="Asia/Dhaka"

# Supabase Identity & Auth (Supabase Auth is the single identity provider)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PostgreSQL Database (Supabase / Standard PostgreSQL)
# Transaction pooler URL (for Prisma Client queries)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection URL (for Prisma migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Operational
NODE_ENV="development"
