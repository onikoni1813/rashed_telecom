// Prisma Schema for Rashed Telecom Shop Management PWA
// Architecture defined in Master_plan.md (Sections 3, 6, 7, 8, 11, 12)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// 6.1 SHOP, IDENTITY, ROLES AND SETTINGS
// ==============================================================================

model Shop {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("BDT")
  timezone  String   @default("Asia/Dhaka")
  settings  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members         ShopMember[]
  staffProfiles   StaffProfile[]
  roles           Role[]
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]

  // Phase 2 Inventory & Purchasing relations
  categories      Category[]
  products        Product[]
  serialNumbers   SerialNumber[]
  suppliers       Supplier[]
  locations       Location[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  stockCounts     StockCount[]
  purchaseReturns PurchaseReturn[]

  // Phase 3 POS, Sales & Accounting relations
  customers       Customer[]
  accounts        Account[]
  journalEntries  JournalEntry[]
  cashSessions    CashSession[]
  sales           Sale[]
  payments        Payment[]
  salesReturns       SalesReturn[]
  serviceJobs        ServiceJob[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  accountingPeriods  AccountingPeriod[]
  attendanceRecords  AttendanceRecord[]
  payrollPayments    PayrollPayment[]
  approvalRequests   ApprovalRequest[]
  notifications      Notification[]

  @@map("shops")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid // Matches Supabase Auth uid
  email     String?  @unique
  phone     String?  @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships      ShopMember[]
  staffProfiles    StaffProfile[]
  auditActions     AuditLog[]                @relation("ActorAuditLogs")
  stockMovements   StockMovement[]
  cashSessions     CashSession[]
  sales            Sale[]
  payments         Payment[]
  salesReturns     SalesReturn[]
  assignedRepairs  ServiceJob[]              @relation("AssignedTechnicianJobs")
  intakeRepairs    ServiceJob[]              @relation("IntakeCashierJobs")
  statusChanges    ServiceJobStatusHistory[]
  diagnostics      ServiceDiagnostic[]
  partsConsumed    ServicePart[]
  expensesRecorded    Expense[]
  periodsClosed       AccountingPeriod[]
  payrollPaymentsPaid PayrollPayment[]
  approvalRequests    ApprovalRequest[]         @relation("ApprovalRequestedBy")
  approvalReviews     ApprovalRequest[]         @relation("ApprovalReviewedBy")
  notifications       Notification[]
  pinHash             String?                   @map("pin_hash")
  pinSalt             String?                   @map("pin_salt")
  credentials         UserCredential[]

  @@map("users")
}

model UserCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  credentialId String    @unique @map("credential_id")
  publicKey    String    @map("public_key")
  counter      Int       @default(0)
  deviceName   String?   @default("Biometric Device") @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_credentials")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String?  @map("shop_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop            Shop?            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  members         ShopMember[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model ShopMember {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@index([roleId])
  @@map("shop_members")
}

model StaffProfile {
  id               String    @id @default(uuid()) @db.Uuid
  shopId           String    @map("shop_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  employeeCode     String    @map("employee_code")
  designation      String?   @default("Staff")
  department       String?   @default("General")
  joiningDate      DateTime  @map("joining_date")
  compensationType String    @default("SALARY") @map("compensation_type")
  baseSalary       Decimal   @default(0) @map("base_salary") @db.Decimal(12, 2)
  commissionRate   Decimal   @default(0) @map("commission_rate") @db.Decimal(5, 2)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]
  payrollPayments   PayrollPayment[]

  @@unique([shopId, employeeCode])
  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("staff_profiles")
}

// ==============================================================================
// 6.2 PRODUCT CATALOGUE
// ==============================================================================

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  type      String   @default("ACCESSORY")
  createdAt DateTime @default(now()) @map("created_at")

  shop     Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([shopId, name])
  @@index([shopId])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  name          String
  brand         String?
  sku           String
  barcode       String?
  modelNumber   String?  @map("model_number")
  isTrackStock  Boolean  @default(true) @map("is_track_stock")
  costPrice     Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  minStockAlert Int      @default(5) @map("min_stock_alert")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants           ProductVariant[]
  serialNumbers      SerialNumber[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  stockCountItems    StockCountItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  salesReturnItems    SalesReturnItem[]
  serviceParts        ServicePart[]

  @@unique([shopId, sku])
  @@index([shopId])
  @@index([categoryId])
  @@index([barcode])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  name         String
  sku          String?
  costPrice    Decimal? @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal? @map("selling_price") @db.Decimal(12, 2)
  attributes   Json?    @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialNumbers       SerialNumber[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  purchaseOrderItems  PurchaseOrderItem[]
  goodsReceiptItems   GoodsReceiptItem[]
  stockCountItems     StockCountItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  salesReturnItems    SalesReturnItem[]
  serviceParts        ServicePart[]

  @@index([productId])
  @@map("product_variants")
}

model SerialNumber {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  imei1           String?  @map("imei_1")
  imei2           String?  @map("imei_2")
  serialNumber    String?  @map("serial_number")
  status          String   @default("IN_STOCK") // IN_STOCK, SOLD, DEFECTIVE, IN_SERVICE
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shop          Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  saleSerials   SaleItemSerial[]

  @@index([shopId, status])
  @@index([shopId, imei1])
  @@index([shopId, serialNumber])
  @@index([productId])
  @@map("serial_numbers")
}

// ==============================================================================
// 6.3 INVENTORY AND PURCHASING
// ==============================================================================

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  name           String
  contactPerson  String?  @map("contact_person")
  phone          String?
  email          String?
  address        String?
  payableBalance Decimal  @default(0) @map("payable_balance") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("suppliers")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  stockCounts    StockCount[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("locations")
}

model PurchaseOrder {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  supplierId  String    @map("supplier_id") @db.Uuid
  poNumber    String    @map("po_number")
  status      String    @default("DRAFT")
  totalAmount Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  orderedAt   DateTime  @default(now()) @map("ordered_at")
  expectedAt  DateTime? @map("expected_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  serialNumbers SerialNumber[]

  @@unique([shopId, poNumber])
  @@index([shopId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String?  @map("variant_id") @db.Uuid
  quantity         Int
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 2)
  receivedQuantity Int      @default(0) @map("received_quantity")
  createdAt        DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  grnNumber       String   @map("grn_number")
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?
  receivedBy      String?  @map("received_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@unique([shopId, grnNumber])
  @@index([shopId, receivedAt])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String   @id @default(uuid()) @db.Uuid
  goodsReceiptId String   @map("goods_receipt_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  quantity       Int
  unitCost       Decimal  @map("unit_cost") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  goodsReceipt GoodsReceipt    @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([productId])
  @@map("goods_receipt_items")
}

model StockBalance {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(12, 2)
  averageCost    Decimal  @default(0) @map("average_cost") @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt @map("updated_at")

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([shopId, productId, variantId, locationId])
  @@index([shopId, locationId])
  @@index([productId])
  @@map("stock_balances")
}

model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  variantId     String?  @map("variant_id") @db.Uuid
  locationId    String   @map("location_id") @db.Uuid
  movementType  String   @map("movement_type")
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  quantity      Decimal  @db.Decimal(12, 2)
  unitCost      Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  balanceAfter  Decimal  @default(0) @map("balance_after") @db.Decimal(12, 2)
  reason        String?
  actorId       String?  @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor    User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([productId, variantId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockCount {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  countName  String   @map("count_name")
  status     String   @default("OPEN")
  startedAt  DateTime @default(now()) @map("started_at")
  closedAt   DateTime? @map("closed_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  location Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items    StockCountItem[]

  @@index([shopId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id              String   @id @default(uuid()) @db.Uuid
  stockCountId    String   @map("stock_count_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  systemQuantity  Decimal  @map("system_quantity") @db.Decimal(12, 2)
  countedQuantity Decimal  @map("counted_quantity") @db.Decimal(12, 2)
  discrepancy     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  stockCount StockCount      @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([stockCountId])
  @@map("stock_count_items")
}

model PurchaseReturn {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  supplierId   String   @map("supplier_id") @db.Uuid
  returnNumber String   @map("return_number")
  reason       String?
  totalAmount  Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now()) @map("created_at")

  shop     Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  supplier Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseReturnItem[]

  @@unique([shopId, returnNumber])
  @@index([shopId])
  @@index([supplierId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseReturnId String   @map("purchase_return_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String?  @map("variant_id") @db.Uuid
  quantity         Int
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  purchaseReturn PurchaseReturn  @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

// ==============================================================================
// 6.4 POS, SALES, PAYMENTS AND RETURNS
// ==============================================================================

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  phone     String
  email     String?
  address   String?
  totalDue  Decimal  @default(0) @map("total_due") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sales        Sale[]
  payments     Payment[]
  salesReturns SalesReturn[]
  serviceJobs  ServiceJob[]

  @@unique([shopId, phone])
  @@index([shopId])
  @@map("customers")
}

model CashSession {
  id                 String    @id @default(uuid()) @db.Uuid
  shopId             String    @map("shop_id") @db.Uuid
  cashierId          String    @map("cashier_id") @db.Uuid
  openingTime        DateTime  @default(now()) @map("opening_time")
  closingTime        DateTime? @map("closing_time")
  openingCash        Decimal   @default(0) @map("opening_cash") @db.Decimal(12, 2)
  closingCashSystem  Decimal   @default(0) @map("closing_cash_system") @db.Decimal(12, 2)
  closingCashActual  Decimal   @default(0) @map("closing_cash_actual") @db.Decimal(12, 2)
  discrepancy        Decimal   @default(0) @db.Decimal(12, 2)
  status             String    @default("OPEN") // OPEN, CLOSED
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")

  shop    Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  cashier User   @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  sales   Sale[]

  @@index([shopId, status])
  @@index([cashierId])
  @@map("cash_sessions")
}

model Sale {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  customerId    String?  @map("customer_id") @db.Uuid
  cashierId     String   @map("cashier_id") @db.Uuid
  cashSessionId String?  @map("cash_session_id") @db.Uuid
  invoiceNumber String   @map("invoice_number")
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueAmount     Decimal  @default(0) @map("due_amount") @db.Decimal(12, 2)
  paymentStatus String   @default("PAID") @map("payment_status") // PAID, PARTIALLY_PAID, DUE
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashier            User                @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  cashSession        CashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  paymentAllocations PaymentAllocation[]
  returns            SalesReturn[]

  @@unique([shopId, invoiceNumber])
  @@index([shopId, createdAt])
  @@index([customerId])
  @@index([cashierId])
  @@map("sales")
}

model SaleItem {
  id         String   @id @default(uuid()) @db.Uuid
  saleId     String   @map("sale_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  sale        Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  serials     SaleItemSerial[]
  returnItems SalesReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SaleItemSerial {
  id             String @id @default(uuid()) @db.Uuid
  saleItemId     String @map("sale_item_id") @db.Uuid
  serialNumberId String @map("serial_number_id") @db.Uuid

  saleItem     SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  serialNumber SerialNumber @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)

  @@unique([saleItemId, serialNumberId])
  @@map("sale_item_serials")
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  paymentNumber   String   @map("payment_number")
  customerId      String?  @map("customer_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String   @map("payment_method") // CASH, BANK, BKASH, NAGAD, ROCKET
  referenceNumber String?  @map("reference_number")
  receivedBy      String   @map("received_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashier     User                @relation(fields: [receivedBy], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([shopId, paymentNumber])
  @@index([shopId, createdAt])
  @@index([customerId])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  saleId    String   @map("sale_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([saleId])
  @@map("payment_allocations")
}

model SalesReturn {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  saleId       String   @map("sale_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  returnNumber String   @map("return_number")
  refundAmount Decimal  @default(0) @map("refund_amount") @db.Decimal(12, 2)
  returnReason String?  @map("return_reason")
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  shop     Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sale     Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator  User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items    SalesReturnItem[]

  @@unique([shopId, returnNumber])
  @@index([shopId])
  @@index([saleId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id              String   @id @default(uuid()) @db.Uuid
  salesReturnId   String   @map("sales_return_id") @db.Uuid
  saleItemId      String   @map("sale_item_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  quantity        Int
  refundUnitPrice Decimal  @map("refund_unit_price") @db.Decimal(12, 2)
  condition       String   @default("GOOD") // GOOD, DEFECTIVE
  createdAt       DateTime @default(now()) @map("created_at")

  salesReturn SalesReturn     @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([salesReturnId])
  @@map("sales_return_items")
}

// ==============================================================================
// 6.6 FINANCE AND GENERAL LEDGER
// ==============================================================================

model Account {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  code      String   // e.g. 1000, 1010, 1100, 1200, 4000, 5000
  name      String
  type      String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  journalLines JournalLine[]
  expenses     Expense[]

  @@unique([shopId, code])
  @@index([shopId, type])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  sourceType  String   @map("source_type") // SALE, PAYMENT, SALES_RETURN, PURCHASE_RECEIPT, EXPENSE, OWNER_DRAWING, OWNER_CAPITAL, DUE_COLLECTION, SUPPLIER_PAYMENT
  sourceId    String   @map("source_id")
  entryDate   DateTime @default(now()) @map("entry_date")
  status      String   @default("POSTED") // POSTED, REVERSED
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  lines           JournalLine[]
  payrollPayments PayrollPayment[]

  @@index([shopId, entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(uuid()) @db.Uuid
  journalEntryId String  @map("journal_entry_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  debit          Decimal @default(0) @db.Decimal(12, 2)
  credit         Decimal @default(0) @db.Decimal(12, 2)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  code      String?  @default("6200") // Suggested GL account code
  createdAt DateTime @default(now()) @map("created_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  expenses Expense[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("expense_categories")
}

model Expense {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  expenseNumber String   @map("expense_number")
  categoryId    String   @map("category_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid // Expense GL account
  paymentMethod String   @map("payment_method") // CASH, BANK, BKASH, NAGAD
  amount        Decimal  @db.Decimal(12, 2)
  expenseDate   DateTime @default(now()) @map("expense_date")
  payee         String?
  receiptRef    String?  @map("receipt_ref")
  notes         String?
  recordedById  String   @map("recorded_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account    Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  recordedBy User            @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([shopId, expenseNumber])
  @@index([shopId, expenseDate])
  @@index([categoryId])
  @@map("expenses")
}

model AccountingPeriod {
  id         String    @id @default(uuid()) @db.Uuid
  shopId     String    @map("shop_id") @db.Uuid
  periodName String    @map("period_name") // e.g. "October 2026"
  startDate  DateTime  @map("start_date")
  endDate    DateTime  @map("end_date")
  isClosed   Boolean   @default(false) @map("is_closed")
  closedAt   DateTime? @map("closed_at")
  closedById String?   @map("closed_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  shop     Shop  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  closedBy User? @relation(fields: [closedById], references: [id], onDelete: SetNull)

  @@unique([shopId, periodName])
  @@index([shopId, isClosed])
  @@map("accounting_periods")
}

model AttendanceRecord {
  id             String    @id @default(uuid()) @db.Uuid
  shopId         String    @map("shop_id") @db.Uuid
  staffProfileId String    @map("staff_profile_id") @db.Uuid
  date           DateTime  @db.Date
  status         String    @default("PRESENT") // PRESENT, ABSENT, LATE, LEAVE
  checkInTime    DateTime? @map("check_in_time")
  checkOutTime   DateTime? @map("check_out_time")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)

  @@unique([shopId, staffProfileId, date])
  @@index([shopId, date])
  @@index([staffProfileId])
  @@map("attendance_records")
}

model PayrollPayment {
  id               String   @id @default(uuid()) @db.Uuid
  shopId           String   @map("shop_id") @db.Uuid
  staffProfileId   String   @map("staff_profile_id") @db.Uuid
  payrollMonth     String   @map("payroll_month") // e.g. "2026-10"
  baseSalary       Decimal  @map("base_salary") @db.Decimal(12, 2)
  commissionAmount Decimal  @default(0) @map("commission_amount") @db.Decimal(12, 2)
  deductions       Decimal  @default(0) @db.Decimal(12, 2)
  netAmount        Decimal  @map("net_amount") @db.Decimal(12, 2)
  paymentMethod    String   @default("CASH") @map("payment_method") // CASH, BANK, BKASH, NAGAD
  paidDate         DateTime @default(now()) @map("paid_date")
  journalEntryId   String?  @map("journal_entry_id") @db.Uuid
  paidById         String   @map("paid_by_id") @db.Uuid
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  staffProfile StaffProfile  @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  paidBy       User          @relation(fields: [paidById], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([shopId, staffProfileId, payrollMonth])
  @@index([shopId, payrollMonth])
  @@index([staffProfileId])
  @@map("payroll_payments")
}

model ApprovalRequest {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  requestType   String    @map("request_type") // STOCK_ADJUSTMENT, LARGE_DISCOUNT, SALARY_PAYOUT, DUE_WAIVER, EXPENSE_APPROVAL
  referenceId   String?   @map("reference_id")
  requestedById String    @map("requested_by_id") @db.Uuid
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById  String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at")
  reviewReason  String?   @map("review_reason")
  details       Json?
  createdAt     DateTime  @default(now()) @map("created_at")

  shop        Shop  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  requestedBy User  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([requestType])
  @@map("approval_requests")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid // null = broadcast to shop
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, APPROVAL, ALERT
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  shop Shop  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId, isRead])
  @@index([userId])
  @@map("notifications")
}

// ==============================================================================
// 6.7 AUDIT LOGS AND IDEMPOTENCY
// ==============================================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  reason      String?
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  actor User @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@index([shopId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  key          String
  requestHash  String    @map("request_hash")
  status       String    @default("PENDING")
  statusCode   Int?      @map("status_code")
  responseBody Json?     @map("response_body")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, key])
  @@index([shopId, createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ==============================================================================
// 6.5 REPAIR SERVICING (PHASE 4)
// ==============================================================================

model ServiceJob {
  id                   String    @id @default(uuid()) @db.Uuid
  shopId               String    @map("shop_id") @db.Uuid
  jobNumber            String    @map("job_number")
  customerId           String    @map("customer_id") @db.Uuid
  deviceBrand          String    @map("device_brand")
  deviceModel          String    @map("device_model")
  deviceImei           String?   @map("device_imei")
  deviceColor          String?   @map("device_color")
  intakeCondition      String    @map("intake_condition")
  accessoriesReceived  String?   @map("accessories_received")
  reportedIssue        String    @map("reported_issue")
  screenLockType       String?   @default("NONE") @map("screen_lock_type")
  devicePasscode       String?   @map("device_passcode")
  status               String    @default("INTAKE") // INTAKE, DIAGNOSING, ESTIMATE_PENDING, ESTIMATE_APPROVED, ESTIMATE_REJECTED, IN_REPAIR, READY_FOR_DELIVERY, DELIVERED, CANCELLED
  assignedTechnicianId String?   @map("assigned_technician_id") @db.Uuid
  intakeCashierId      String    @map("intake_cashier_id") @db.Uuid
  promisedDate         DateTime? @map("promised_date")
  estimatedCost        Decimal   @default(0) @map("estimated_cost") @db.Decimal(12, 2)
  labourCost           Decimal   @default(0) @map("labour_cost") @db.Decimal(12, 2)
  partsCost            Decimal   @default(0) @map("parts_cost") @db.Decimal(12, 2)
  outsideCost          Decimal   @default(0) @map("outside_cost") @db.Decimal(12, 2)
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount           Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueAmount            Decimal   @default(0) @map("due_amount") @db.Decimal(12, 2)
  paymentStatus        String    @default("PENDING") @map("payment_status") // PENDING, PARTIALLY_PAID, PAID
  deliveryDate         DateTime? @map("delivery_date")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  shop               Shop                      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTechnician User?                     @relation("AssignedTechnicianJobs", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  intakeCashier      User                      @relation("IntakeCashierJobs", fields: [intakeCashierId], references: [id], onDelete: Restrict)
  statusHistory      ServiceJobStatusHistory[]
  diagnostics        ServiceDiagnostic[]
  parts              ServicePart[]
  warranties         ServiceWarranty[]

  @@unique([shopId, jobNumber])
  @@index([shopId, status])
  @@index([customerId])
  @@index([assignedTechnicianId])
  @@index([createdAt])
  @@map("service_jobs")
}

model ServiceJobStatusHistory {
  id           String   @id @default(uuid()) @db.Uuid
  serviceJobId String   @map("service_job_id") @db.Uuid
  fromStatus   String   @map("from_status")
  toStatus     String   @map("to_status")
  changedById  String   @map("changed_by_id") @db.Uuid
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  serviceJob ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  changedBy  User       @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([serviceJobId])
  @@map("service_job_status_history")
}

model ServiceDiagnostic {
  id                String    @id @default(uuid()) @db.Uuid
  serviceJobId      String    @map("service_job_id") @db.Uuid
  technicianId      String    @map("technician_id") @db.Uuid
  diagnosisFindings String    @map("diagnosis_findings")
  estimatedLabour   Decimal   @default(0) @map("estimated_labour") @db.Decimal(12, 2)
  estimatedParts    Decimal   @default(0) @map("estimated_parts") @db.Decimal(12, 2)
  customerApproved  Boolean?  @map("customer_approved")
  approvedAt        DateTime? @map("approved_at")
  customerNotes     String?   @map("customer_notes")
  createdAt         DateTime  @default(now()) @map("created_at")

  serviceJob ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  technician User       @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([serviceJobId])
  @@map("service_diagnostics")
}

model ServicePart {
  id           String   @id @default(uuid()) @db.Uuid
  serviceJobId String   @map("service_job_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  quantity     Int      @default(1)
  unitCost     Decimal  @map("unit_cost") @db.Decimal(12, 2)
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  consumedById String   @map("consumed_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  serviceJob ServiceJob      @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  consumedBy User            @relation(fields: [consumedById], references: [id], onDelete: Restrict)

  @@index([serviceJobId])
  @@index([productId])
  @@map("service_parts")
}

model ServiceWarranty {
  id            String   @id @default(uuid()) @db.Uuid
  serviceJobId  String   @map("service_job_id") @db.Uuid
  warrantyDays  Int      @default(30) @map("warranty_days")
  warrantyTerms String   @map("warranty_terms")
  startDate     DateTime @default(now()) @map("start_date")
  endDate       DateTime @map("end_date")
  createdAt     DateTime @default(now()) @map("created_at")

  serviceJob ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)

  @@index([serviceJobId])
  @@map("service_warranties")
}

