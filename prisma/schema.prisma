// Prisma Schema for Rashed Telecom Shop Management PWA
// Architecture defined in Master_plan.md (Sections 3, 6, 11, 12)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// 6.1 SHOP, IDENTITY, ROLES AND SETTINGS
// ==============================================================================

model Shop {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("BDT")
  timezone  String   @default("Asia/Dhaka")
  settings  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members         ShopMember[]
  staffProfiles   StaffProfile[]
  roles           Role[]
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]

  // Phase 2 Inventory & Purchasing relations
  categories      Category[]
  products        Product[]
  serialNumbers   SerialNumber[]
  suppliers       Supplier[]
  locations       Location[]
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  stockCounts     StockCount[]
  purchaseReturns PurchaseReturn[]

  @@map("shops")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid // Matches Supabase Auth uid
  email     String?  @unique
  phone     String?  @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    ShopMember[]
  staffProfiles  StaffProfile[]
  auditActions   AuditLog[]      @relation("ActorAuditLogs")
  stockMovements StockMovement[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String?  @map("shop_id") @db.Uuid // Nullable for global system roles
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop            Shop?            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  members         ShopMember[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. 'products.view', 'sales.create'
  description String
  module      String   // e.g. 'products', 'sales', 'service', 'accounting'
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model ShopMember {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@index([roleId])
  @@map("shop_members")
}

model StaffProfile {
  id               String    @id @default(uuid()) @db.Uuid
  shopId           String    @map("shop_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  employeeCode     String    @map("employee_code")
  joiningDate      DateTime  @map("joining_date")
  compensationType String    @default("SALARY") @map("compensation_type") // SALARY, COMMISSION, HOURLY
  baseSalary       Decimal   @default(0) @map("base_salary") @db.Decimal(12, 2)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([shopId, employeeCode])
  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
  @@map("staff_profiles")
}

// ==============================================================================
// 6.2 PRODUCT CATALOGUE
// ==============================================================================

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  type      String   @default("ACCESSORY") // PHONE, ACCESSORY, PART, CONSUMABLE
  createdAt DateTime @default(now()) @map("created_at")

  shop     Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([shopId, name])
  @@index([shopId])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  name          String
  brand         String?
  sku           String
  barcode       String?
  modelNumber   String?  @map("model_number")
  isTrackStock  Boolean  @default(true) @map("is_track_stock")
  costPrice     Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  minStockAlert Int      @default(5) @map("min_stock_alert")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants           ProductVariant[]
  serialNumbers      SerialNumber[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  stockCountItems    StockCountItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@unique([shopId, sku])
  @@index([shopId])
  @@index([categoryId])
  @@index([barcode])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  name         String   // e.g. "6GB/128GB - Phantom Black"
  sku          String?
  costPrice    Decimal? @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal? @map("selling_price") @db.Decimal(12, 2)
  attributes   Json?    @default("{}") // color, storage, ram, etc.
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialNumbers      SerialNumber[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  stockCountItems    StockCountItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@index([productId])
  @@map("product_variants")
}

model SerialNumber {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  imei1           String?  @map("imei_1")
  imei2           String?  @map("imei_2")
  serialNumber    String?  @map("serial_number")
  status          String   @default("IN_STOCK") // IN_STOCK, SOLD, DEFECTIVE, IN_SERVICE
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([shopId, imei1])
  @@index([shopId, serialNumber])
  @@index([productId])
  @@map("serial_numbers")
}

// ==============================================================================
// 6.3 INVENTORY AND PURCHASING
// ==============================================================================

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  name           String
  contactPerson  String?  @map("contact_person")
  phone          String?
  email          String?
  address        String?
  payableBalance Decimal  @default(0) @map("payable_balance") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("suppliers")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String   // e.g. "Main Shop Floor", "Backstore Warehouse"
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  stockCounts    StockCount[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("locations")
}

model PurchaseOrder {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  supplierId  String    @map("supplier_id") @db.Uuid
  poNumber    String    @map("po_number")
  status      String    @default("DRAFT") // DRAFT, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  totalAmount Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  orderedAt   DateTime  @default(now()) @map("ordered_at")
  expectedAt  DateTime? @map("expected_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  serialNumbers SerialNumber[]

  @@unique([shopId, poNumber])
  @@index([shopId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String?  @map("variant_id") @db.Uuid
  quantity         Int
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 2)
  receivedQuantity Int      @default(0) @map("received_quantity")
  createdAt        DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @map("shop_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  grnNumber       String   @map("grn_number")
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?
  receivedBy      String?  @map("received_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@unique([shopId, grnNumber])
  @@index([shopId, receivedAt])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String   @id @default(uuid()) @db.Uuid
  goodsReceiptId String   @map("goods_receipt_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  quantity       Int
  unitCost       Decimal  @map("unit_cost") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  goodsReceipt GoodsReceipt    @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([productId])
  @@map("goods_receipt_items")
}

model StockBalance {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(12, 2)
  averageCost    Decimal  @default(0) @map("average_cost") @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt @map("updated_at")

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([shopId, productId, variantId, locationId])
  @@index([shopId, locationId])
  @@index([productId])
  @@map("stock_balances")
}

model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  variantId     String?  @map("variant_id") @db.Uuid
  locationId    String   @map("location_id") @db.Uuid
  movementType  String   @map("movement_type") // PURCHASE_RECEIPT, SALE, SERVICE_CONSUMPTION, ADJUSTMENT_IN, ADJUSTMENT_OUT, PURCHASE_RETURN, SALES_RETURN
  referenceType String?  @map("reference_type") // GoodsReceipt, Sale, ServiceJob, StockAdjustment
  referenceId   String?  @map("reference_id")
  quantity      Decimal  @db.Decimal(12, 2) // positive for additions, negative for deductions
  unitCost      Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  balanceAfter  Decimal  @default(0) @map("balance_after") @db.Decimal(12, 2)
  reason        String?
  actorId       String?  @map("actor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actor    User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([productId, variantId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockCount {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  countName  String   @map("count_name")
  status     String   @default("OPEN") // OPEN, COMPLETED, CANCELLED
  startedAt  DateTime @default(now()) @map("started_at")
  closedAt   DateTime? @map("closed_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  location Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items    StockCountItem[]

  @@index([shopId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id              String   @id @default(uuid()) @db.Uuid
  stockCountId    String   @map("stock_count_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  systemQuantity  Decimal  @map("system_quantity") @db.Decimal(12, 2)
  countedQuantity Decimal  @map("counted_quantity") @db.Decimal(12, 2)
  discrepancy     Decimal  @default(0) @db.Decimal(12, 2) // countedQuantity - systemQuantity
  createdAt       DateTime @default(now()) @map("created_at")

  stockCount StockCount      @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([stockCountId])
  @@map("stock_count_items")
}

model PurchaseReturn {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  supplierId   String   @map("supplier_id") @db.Uuid
  returnNumber String   @map("return_number")
  reason       String?
  totalAmount  Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now()) @map("created_at")

  shop     Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  supplier Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseReturnItem[]

  @@unique([shopId, returnNumber])
  @@index([shopId])
  @@index([supplierId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseReturnId String   @map("purchase_return_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String?  @map("variant_id") @db.Uuid
  quantity         Int
  unitCost         Decimal  @map("unit_cost") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  purchaseReturn PurchaseReturn  @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

// ==============================================================================
// 6.7 AUDIT LOGS AND IDEMPOTENCY
// ==============================================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  action      String   // e.g. 'member.create', 'role.assign', 'settings.update'
  entityType  String   @map("entity_type") // e.g. 'ShopMember', 'StaffProfile'
  entityId    String   @map("entity_id")
  reason      String?
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  actor User @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@index([shopId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  key          String
  requestHash  String    @map("request_hash")
  status       String    @default("PENDING") // PENDING, COMPLETED, FAILED
  statusCode   Int?      @map("status_code")
  responseBody Json?     @map("response_body")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, key])
  @@index([shopId, createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
